# Copy this file to .env in the Java project root, then fill in your values.
# Spring Boot and Docker Compose read it from this working directory.
# Use unquoted KEY=value entries, without `export` or trailing comments.
# Spring reads this as Java properties: escape a literal backslash as \\.

# Runtime: default for local development; prod requires email verification.
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080

# PostgreSQL container (use the existing credentials if the volume already exists).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend database connection. Keep these credentials aligned with PostgreSQL.
DATABASE_URL=jdbc:postgresql://localhost:5432/dailyreminder
DATABASE_USER=postgres
DATABASE_PASS=postgres

# Token signing. Generate a value with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public frontend origin used in verification and password-reset links.
# Do not append /api or /auth. Use your HTTPS frontend URL in production.
FRONTEND_URL=http://localhost:3000

# Enable mail only after configuring SMTP below.
# The prod profile always enables mail and requires verification.
APP_MAIL_ENABLED=false
APP_AUTH_REQUIRE_VERIFICATION=false
MAIL_FROM=noreply@example.com

# SMTP provider credentials (e.g. a provider-issued SMTP/app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# For implicit TLS on port 465: SMTP_PORT=465, SMTP_STARTTLS=false, SMTP_SSL=true.
# A local mail catcher can use SMTP_AUTH=false and SMTP_STARTTLS=false.
